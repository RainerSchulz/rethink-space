# Kopie als .env anlegen (.env ist gitignored). Nur öffentliche Werte, keine Secrets.
# URL der Chat-Funktion (Supabase Edge Function). Leer = Chat-Widget bleibt aus.
VITE_CHAT_ENDPOINT=
# Zugangsschutz der Testphase: SHA-256 von "e-mail:passwort" (Kleinbuchstaben),
# mehrere Zugänge durch Komma getrennt.
# Leer lassen = Seite ist offen (Livegang).
VITE_GATE_HASH=
